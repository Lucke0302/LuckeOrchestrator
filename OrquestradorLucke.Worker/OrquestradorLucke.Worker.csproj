<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-OrquestradorLucke.Worker-b39b4187-3791-48d6-9724-9bd84e567537</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Microsoft.Extensions.Hosting não é referenciado aqui de propósito: o FrameworkReference do
         ASP.NET Core (abaixo) já o traz na versão do runtime, e o SDK poda o pacote duplicado (NU1510). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.7" />
    <!-- Autenticação das rotas administrativas: valida o access token JWT (HS256) emitido pela
         Infrastructure. O pacote traz a cadeia Microsoft.IdentityModel compatível com o runtime. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Host HTTP (Kestrel + Minimal APIs): o worker expõe o endpoint do webhook do GitHub sem
         deixar de ser um BackgroundService. Referência de framework, e não pacote: nada é replicado
         no publish (o runtime do ASP.NET Core já é compartilhado pelo servidor). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrquestradorLucke.Infrastructure\OrquestradorLucke.Infrastructure.csproj" />
  </ItemGroup>
</Project>
