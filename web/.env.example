# Endereço do host HTTP do Orquestrador Lucke (daemon .NET):
# webhook do GitHub, /api/auth, /api/tasks e o hub de logs (/hubs/logs).
# Copie este arquivo para `.env.local` e ajuste por ambiente; sem a variável,
# o painel usa http://localhost:5000/api.
VITE_API_BASE_URL=http://localhost:5000/api

# Opcional: URL do hub SignalR de logs. Sem ela, o painel monta o endereço a partir da
# VITE_API_BASE_URL (troca o sufixo /api por /hubs/logs).
# VITE_HUB_URL=http://localhost:5000/hubs/logs
